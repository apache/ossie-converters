  {
   "id": "metric_synth_sales_per_shopper",
   "kind": "metric",
   "app": "metric",
   "name": "sales_per_shopper",
   "display_name": "Sales Per Shopper",
   "description": "Average store sales per active shopper, by store and state, for active Majors customers.",
   "artifact_status": "active",
   "workspace_id": "workspace_synthetic_tpcds",
   "version_ordinal": 1,
   "source_type": "external",
   "source_id": "synthetic:sales_per_shopper",
   "metadata": {
    "definition": {
     "spec_version": "1.0-draft.4",
     "version": 1,
     "dialect": "snowflake",
     "aggregation": {
      "type": "ratio",
      "zero_denominator": "null",
      "null_handling": "shoppers with no sales are not counted",
      "reaggregation": "not additive: recompute sales and distinct shoppers, then divide"
     },
     "output": {
      "alias": "sales_per_shopper",
      "datatype": "decimal",
      "unit": "sales per shopper"
     },
     "joins": [
      {
       "name": "a",
       "to": "TPCDS.PUBLIC.CUSTOMER",
       "sql": "LEFT(m.SS_CUSTOMER_ID, 15) = LEFT(a.C_CUSTOMER_ID, 15)",
       "cardinality": "many_to_one",
       "origin": "observed in analyst query (LEFT JOIN)"
      },
      {
       "name": "u",
       "to": "TPCDS.PUBLIC.CUSTOMER_ADDRESS",
       "sql": "a.C_CURRENT_ADDR_SK = u.CA_ADDRESS_SK",
       "cardinality": "many_to_one",
       "origin": "observed in analyst query (LEFT JOIN)"
      }
     ],
     "dimensions": [
      {
       "name": "store_sk",
       "kind": "categorical",
       "sql": "m.SS_STORE_SK",
       "datatype": "string",
       "description": "The store."
      },
      {
       "name": "state",
       "kind": "categorical",
       "sql": "COALESCE(NULLIF(u.CA_STATE, ''), '(unknown)')",
       "datatype": "string",
       "required_join": "u",
       "description": "Customer state, '(unknown)' when missing."
      },
      {
       "name": "sale_date",
       "kind": "time",
       "sql": "DATE_TRUNC('day', m.SS_SOLD_TIMESTAMP)",
       "datatype": "date",
       "description": "Day of sale."
      },
      {
       "name": "segment",
       "kind": "categorical",
       "sql": "a.C_SEGMENT",
       "datatype": "string",
       "values": [
        "Majors",
        "Growth"
       ],
       "values_truncated": true,
       "value_map": {
        "Majors": "large accounts",
        "Growth": "mid-size accounts"
       },
       "filter_form": "a.C_SEGMENT = :value",
       "description": "Customer segment."
      }
     ],
     "filters": [
      "a.C_SEGMENT = 'Majors'",
      "a.C_IS_ACTIVE = TRUE",
      "m.SS_SOLD_TIMESTAMP >= :start_date AND m.SS_SOLD_TIMESTAMP < DATEADD(day, 1, :end_date)"
     ],
     "mandatory_filters": [
      "m.SS_CHANNEL = 'store'",
      "m.SS_CUSTOMER_EMAIL NOT ILIKE '%@example.com%'"
     ],
     "examples": [
      {
       "question": "Which stores have the most sales per shopper this quarter?",
       "sql": "SELECT m.SS_STORE_SK, COALESCE(NULLIF(u.CA_STATE,''),'(unknown)') AS STATE, COUNT(*) / NULLIF(COUNT(DISTINCT m.SS_CUSTOMER_SK), 0) AS SALES_PER_SHOPPER FROM TPCDS.PUBLIC.STORE_SALES m LEFT JOIN TPCDS.PUBLIC.CUSTOMER a ON LEFT(m.SS_CUSTOMER_ID,15)=LEFT(a.C_CUSTOMER_ID,15) LEFT JOIN TPCDS.PUBLIC.CUSTOMER_ADDRESS u ON a.C_CURRENT_ADDR_SK = u.CA_ADDRESS_SK WHERE a.C_SEGMENT = 'Majors' AND a.C_IS_ACTIVE = TRUE AND m.SS_CHANNEL = 'store' AND m.SS_CUSTOMER_EMAIL NOT ILIKE '%@example.com%' AND m.SS_SOLD_TIMESTAMP >= '2026-03-18' AND m.SS_SOLD_TIMESTAMP < DATEADD(day,1,'2026-06-16') GROUP BY 1, 2 ORDER BY SALES_PER_SHOPPER DESC",
       "source": "analyst"
      },
      {
       "question": "What is the sales-per-shopper ratio for the Majors segment?",
       "sql": "SELECT a.C_SEGMENT AS SEGMENT, COUNT(*) / NULLIF(COUNT(DISTINCT m.SS_CUSTOMER_SK), 0) AS SALES_PER_SHOPPER FROM TPCDS.PUBLIC.STORE_SALES m LEFT JOIN TPCDS.PUBLIC.CUSTOMER a ON LEFT(m.SS_CUSTOMER_ID,15)=LEFT(a.C_CUSTOMER_ID,15) WHERE a.C_SEGMENT = 'Majors' AND a.C_IS_ACTIVE = TRUE AND m.SS_CHANNEL = 'store' AND m.SS_SOLD_TIMESTAMP >= '2026-03-18' GROUP BY 1",
       "source": "analyst"
      }
     ],
     "exclusions": [
      "online channel (SS_CHANNEL != 'store')",
      "test accounts (email ILIKE '%@example.com%')"
     ],
     "grain": "store_sk, state",
     "population": "Store-channel sales to active Majors customers, excluding test emails",
     "provenance": {
      "source": "analyst",
      "trust_score": 8.0,
      "observed_sql": null
     },
     "extensions": {},
     "formula": "COUNT(*) / NULLIF(COUNT(DISTINCT m.SS_CUSTOMER_SK), 0)",
     "source": {
      "sql": null,
      "table": "TPCDS.PUBLIC.STORE_SALES",
      "alias": "m",
      "entity": "TPCDS.PUBLIC.STORE_SALES",
      "parameters": [
       {
        "name": "start_date",
        "datatype": "date",
        "default": "2026-03-18"
       },
       {
        "name": "end_date",
        "datatype": "date",
        "default": "2026-06-16"
       }
      ],
      "timeframe_column": "SS_SOLD_TIMESTAMP"
     },
     "depends_on": [
      "store_sales_count"
     ]
    },
    "validation_warnings": []
   }
  },
