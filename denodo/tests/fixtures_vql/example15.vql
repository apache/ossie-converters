    );

CREATE OR REPLACE WRAPPER JDBC dw_fact_sales
    DATASOURCENAME=psql_ds
    SCHEMANAME='xxxxx' 
    RELATIONNAME='dw_fact_sales' 
    OUTPUTSCHEMA (
        sale_id = 'sale_id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigserial')  NOT NULL SORTABLE IS_AUTOINCREMENT,
        date_key = 'date_key' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='int4')  SORTABLE,
        customer_key = 'customer_key' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='int4')  SORTABLE,
        product_key = 'product_key' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='int4')  SORTABLE,
        store_key = 'store_key' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='int4')  SORTABLE,
        quantity = 'quantity' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='int4')  SORTABLE,
        unit_price = 'unit_price' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='2', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='2', sourcetypename='numeric')  SORTABLE,
        total_amount = 'total_amount' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='2', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='2', sourcetypename='numeric')  SORTABLE IS_GENERATEDCOLUMN
    )
    CONSTRAINT 'dw_fact_sales_pkey' PRIMARY KEY ( 'sale_id' )
    CONSTRAINT 'dw_fact_sales_customer_key_fkey' FOREIGN KEY ( 'customer_key' ) 
    REFERENCES 'xxxxx'.'dw_dim_customers'( 'customer_key' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    CONSTRAINT 'dw_fact_sales_date_key_fkey' FOREIGN KEY ( 'date_key' ) 
    REFERENCES 'xxxxx'.'dw_dim_date'( 'date_key' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    CONSTRAINT 'dw_fact_sales_product_key_fkey' FOREIGN KEY ( 'product_key' ) 
    REFERENCES 'xxxxx'.'dw_dim_products'( 'product_key' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    CONSTRAINT 'dw_fact_sales_store_key_fkey' FOREIGN KEY ( 'store_key' ) 
    REFERENCES 'xxxxx'.'dw_dim_stores'( 'store_key' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    INDEX 'dw_fact_sales_pkey' OTHER UNIQUE PRIMARY ( 'sale_id' );

CREATE OR REPLACE TABLE dw_fact_sales I18N es_euro (
        sale_id:long (notnull, autoincrement, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19'),
        date_key:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        customer_key:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        product_key:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        store_key:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        quantity:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        unit_price:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '10'),
        total_amount:decimal (generatedcolumn, sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '10')
    )
    CONSTRAINT 'dw_fact_sales_pkey' PRIMARY KEY ( 'sale_id' )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD dw_fact_sales(
        I18N es_euro
        CONSTRAINTS (
             ADD sale_id (any) OPT ANY
             ADD date_key (any) OPT ANY
             ADD customer_key (any) OPT ANY
             ADD product_key (any) OPT ANY
             ADD store_key (any) OPT ANY
             ADD quantity (any) OPT ANY
             ADD unit_price (any) OPT ANY
             ADD total_amount (any) OPT ANY
        )
        OUTPUTLIST (customer_key, date_key, product_key, quantity, sale_id, store_key, total_amount, unit_price
        )
        WRAPPER (jdbc dw_fact_sales)
    );

CREATE OR REPLACE WRAPPER JDBC dw_dim_products
    FOLDER = '/2. base views'
    DATASOURCENAME=psql_ds
    SCHEMANAME='xxxxx' 
    RELATIONNAME='dw_dim_products' 
    OUTPUTSCHEMA (
        product_key = 'product_key' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='serial')  NOT NULL SORTABLE IS_AUTOINCREMENT,
        category_key = 'category_key' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='int4')  SORTABLE,
        sku = 'sku' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='50', sourcetypeid='12', sourcetypename='varchar')  SORTABLE,
        product_name = 'product_name' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='100', sourcetypeid='12', sourcetypename='varchar')  SORTABLE,
        price = 'price' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='2', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='2', sourcetypename='numeric')  SORTABLE
    )
    CONSTRAINT 'dw_dim_products_pkey' PRIMARY KEY ( 'product_key' )
    CONSTRAINT 'dw_dim_products_category_key_fkey' FOREIGN KEY ( 'category_key' ) 
    REFERENCES 'dev'.'dw_dim_categories'( 'category_key' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    INDEX 'dw_dim_products_pkey' OTHER UNIQUE PRIMARY ( 'product_key' )
    INDEX 'dw_dim_products_sku_key' OTHER UNIQUE ( 'sku' );

CREATE OR REPLACE TABLE dw_dim_products I18N es_euro (
        product_key:int (notnull, autoincrement, sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        category_key:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        sku:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '50'),
        product_name:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '100'),
        price:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '10')
    )
    FOLDER = '/2. base views'
    CONSTRAINT 'dw_dim_products_pkey' PRIMARY KEY ( 'product_key' )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD dw_dim_products(
        I18N es_euro
        CONSTRAINTS (
             ADD product_key (any) OPT ANY
             ADD category_key (any) OPT ANY
             ADD sku (any) OPT ANY
             ADD product_name (any) OPT ANY
             ADD price (any) OPT ANY
        )
        OUTPUTLIST (category_key, price, product_key, product_name, sku
        )
        WRAPPER (jdbc dw_dim_products)
    );

CREATE OR REPLACE FOLDER '/3. views' ;

CREATE OR REPLACE FOLDER '/99. Assoc' ;

CREATE OR REPLACE ASSOCIATION dw_dim_customers_dw_fact_sales REFERENTIAL CONSTRAINT 
FOLDER = '/99. assoc'
    ENDPOINT dw_fact_sales dw_dim_customers PRINCIPAL (0,1)
    ENDPOINT dw_dim_customers dw_fact_sales (0,*)
    ADD MAPPING round(customer_key)=customer_key;

CREATE OR REPLACE ASSOCIATION dw_dim_products_dw_fact_sales REFERENTIAL CONSTRAINT 
FOLDER = '/99. assoc'
    ENDPOINT dw_fact_sales dw_dim_products PRINCIPAL (0,1)
    ENDPOINT dw_dim_products dw_fact_sales (0,*)
    ADD MAPPING product_key=product_key;

CREATE OR REPLACE ASSOCIATION dw_dim_date_dw_fact_sales REFERENTIAL CONSTRAINT 
FOLDER = '/99. assoc'
    ENDPOINT dw_fact_sales dw_dim_date PRINCIPAL (0,1)
    ENDPOINT dw_dim_date dw_fact_sales (0,*)
    ADD MAPPING date_key=date_key;

CREATE OR REPLACE METRIC VIEW products_view1
    FOLDER = '/3. views'
     (
    unit_price_sales (description = 'unit prices per sale'),
    product_name (description = 'Product name'),
    product_sku (description = 'product sku description'),
    year (sourcetyperadix = '10', sourcetypesize = '10', sourcetypeid = '4'),
    total_quantity (description = 'Total quantity of orders')
 )
SOURCES (
        dates AS dw_dim_date,
        customers AS dw_dim_customers,
        sales AS dw_fact_sales,
        products AS dw_dim_products    
    )
    ASSOCIATIONS (
        customers sales dw_dim_customers_dw_fact_sales,
        products sales dw_dim_products_dw_fact_sales,
        dates sales dw_dim_date_dw_fact_sales    
    )
    DIMENSIONS (
        products(
            product_name AS products.product_name,
            product_sku AS products.sku
        ),
        customers(
            customer_name AS concat(customers.last_name, ', ', customers.first_name),
            customer_email AS customers.email,
            customer_id AS customers.customer_key
        ),
        dates(
            date_full AS dates.full_date,
            year AS getyear(dates.full_date)
        ),
        unit_price_sales AS (sales.unit_price||'test')    
    )
    METRICS (
        total_quantity AS sum(sales.quantity),
        avg_quantity AS avg(sales.quantity),
        count_prod AS count(products.product_name),
        number_sales AS count(sales.sale_id)    
    )
;

ALTER VIEW products_view1
 LAYOUT (dw_dim_products = [0, 0, 200, 200], dw_dim_customers = [0, 200, 200, 200], dw_dim_date = [0, 400, 200, 200], dw_fact_sales = [0, 600, 200, 200]);

