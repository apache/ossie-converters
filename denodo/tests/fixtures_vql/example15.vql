CREATE OR REPLACE FOLDER '/1. Data Sources' ;

CREATE OR REPLACE DATASOURCE JDBC psql_ds
    FOLDER = '/1. data sources'
    DRIVERCLASSNAME = 'org.postgresql.Driver'
    DATABASEURI = 'xxxxx'
    USERNAME = 'xxxx'
    USERPASSWORD = 'xxxxxxx'
    CLASSPATH = 'postgresql-17'
    DATABASENAME = 'postgresql'
    DATABASEVERSION = '17'
    FETCHSIZE = 10000
    VALIDATIONQUERY = 'Select 1'
    INITIALSIZE = 4
    MAXIDLE = -1
    MINIDLE = 0
    MAXACTIVE = 20
    EXHAUSTEDACTION = 1
    TESTONBORROW = true
    TESTONRETURN = false
    TESTWHILEIDLE = false
    TIMEBETWEENEVICTION = -1
    NUMTESTPEREVICTION = 3
    MINEVICTABLETIME = 1800000
    POOLPREPAREDSTATEMENTS = false
    MAXOPENPREPAREDSTATEMENTS = -1
    PROPERTIES ('escapeSyntaxCallMode'='callIfNoReturn')
    SOURCECONFIGURATION (
        delegatefetchinsubqueries = false,
        delegateoffsetinsubqueries = false,
        delegateorderby = false,
        supportseqouterjoinoperator = false,
        delegateaggregatefunctionslist = (avg, count, max, min, stdev, stdevp, sum, var, varp),
        delegatescalarfunctionslist = (abs, acos, addday, addhour, addmillis, addminute, addmonth, addsecond, addweek, addyear, ascii, asin, atan, atan2, base64_to_hex, case, cast, ceil, char, coalesce, concat, convert_timezone, convert_timezone(evaluate_literal), cos, cot, current_date, degrees, deletespaces, div, exp, expression_list, firstdayofmonth, floor, formatdate, getday, getdayofweek, getdayofyear, getdaysbetween, gethour, getmillisecond, getminute, getmonth, getquarter, getsecond, getweek, getyear, hex_to_base64, instr, lastdayofmonth, len, ln, localtimestamp(evaluate_literal), log, lower, ltrim, max, min, mod, mult, now, nullif, pi, position, pow, power, propercase, radians, rand, regexp, removeaccents, repeat, replace, round, rtrim, sign, sin, sql_trim, sqrt, substr, substring, subtract, sum, tan, textcat, to_date, to_interval_day_second(evaluate_literal), to_interval_year_month(evaluate_literal), to_localdate, to_time, to_timestamp, to_timestamptz, trim, trunc, upper)
    );

CREATE OR REPLACE FOLDER '/2. Base Views' ;

CREATE OR REPLACE WRAPPER JDBC dw_dim_date
    FOLDER = '/2. base views'
    DATASOURCENAME=psql_ds
    SCHEMANAME='xxxxx' 
    RELATIONNAME='dw_dim_date' 
    OUTPUTSCHEMA (
        date_key = 'date_key' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='int4')  NOT NULL SORTABLE,
        full_date = 'full_date' :'java.time.LocalDate' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='13', sourcetypeid='91', sourcetypename='date')  NOT NULL SORTABLE,
        day_name = 'day_name' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='12', sourcetypename='varchar')  SORTABLE,
        day_of_week = 'day_of_week' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='int4')  SORTABLE,
        day_of_month = 'day_of_month' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='int4')  SORTABLE,
        month_name = 'month_name' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='12', sourcetypename='varchar')  SORTABLE,
        month_number = 'month_number' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='int4')  SORTABLE,
        quarter = 'quarter' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='int4')  SORTABLE,
        year = 'year' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='int4')  ESCAPE SORTABLE,
        is_weekend = 'is_weekend' :'java.lang.Boolean' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='1', sourcetypeid='-7', sourcetypename='bool')  NOT SORTABLE,
        is_holiday = 'is_holiday' :'java.lang.Boolean' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='1', sourcetypeid='-7', sourcetypename='bool')  NOT SORTABLE
    )
    CONSTRAINT 'dw_dim_date_pkey' PRIMARY KEY ( 'date_key' )
    INDEX 'dw_dim_date_pkey' OTHER UNIQUE PRIMARY ( 'date_key' );

CREATE OR REPLACE TABLE dw_dim_date I18N es_euro (
        date_key:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        full_date:localdate (notnull, sourcetypeid = '91', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '13'),
        day_name:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        day_of_week:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        day_of_month:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        month_name:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        month_number:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        quarter:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        year:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        is_weekend:boolean (sourcetypeid = '16', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '1'),
        is_holiday:boolean (sourcetypeid = '16', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '1')
    )
    FOLDER = '/2. base views'
    CONSTRAINT 'dw_dim_date_pkey' PRIMARY KEY ( 'date_key' )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD dw_dim_date(
        I18N es_euro
        CONSTRAINTS (
             ADD date_key (any) OPT ANY
             ADD full_date (any) OPT ANY
             ADD day_name (any) OPT ANY
             ADD day_of_week (any) OPT ANY
             ADD day_of_month (any) OPT ANY
             ADD month_name (any) OPT ANY
             ADD month_number (any) OPT ANY
             ADD quarter (any) OPT ANY
             ADD year (any) OPT ANY
             ADD is_weekend (any) OPT ANY
             ADD is_holiday (any) OPT ANY
        )
        OUTPUTLIST (date_key, day_name, day_of_month, day_of_week, full_date, is_holiday, is_weekend, month_name, month_number, quarter, year
        )
        WRAPPER (jdbc dw_dim_date)
    );

CREATE OR REPLACE WRAPPER JDBC dw_dim_customers
    FOLDER = '/2. base views'
    DATASOURCENAME=psql_ds
    SCHEMANAME='xxxxx' 
    RELATIONNAME='dw_dim_customers' 
    OUTPUTSCHEMA (
        customer_key = 'customer_key' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', sourcetypeid='4', sourcetypename='serial')  NOT NULL SORTABLE IS_AUTOINCREMENT,
        first_name = 'first_name' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='50', sourcetypeid='12', sourcetypename='varchar')  SORTABLE,
        last_name = 'last_name' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='50', sourcetypeid='12', sourcetypename='varchar')  SORTABLE,
        email = 'email' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='100', sourcetypeid='12', sourcetypename='varchar')  SORTABLE,
        registration_date = 'registration_date' :'java.time.LocalDate' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='13', sourcetypeid='91', sourcetypename='date')  SORTABLE
    )
    CONSTRAINT 'dw_dim_customers_pkey' PRIMARY KEY ( 'customer_key' )
    INDEX 'dw_dim_customers_pkey' OTHER UNIQUE PRIMARY ( 'customer_key' );

CREATE OR REPLACE TABLE dw_dim_customers I18N es_euro (
        customer_key:int (notnull, autoincrement, sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        first_name:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '50'),
        last_name:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '50'),
        email:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '100'),
        registration_date:localdate (sourcetypeid = '91', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '13')
    )
    FOLDER = '/2. base views'
    CONSTRAINT 'dw_dim_customers_pkey' PRIMARY KEY ( 'customer_key' )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD dw_dim_customers(
        I18N es_euro
        CONSTRAINTS (
             ADD customer_key (any) OPT ANY
             ADD first_name (any) OPT ANY
             ADD last_name (any) OPT ANY
             ADD email (any) OPT ANY
             ADD registration_date (any) OPT ANY
        )
