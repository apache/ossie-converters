{
 "active_shoppers_change_vs_60_90_days_ago": {
  "name": "active_shoppers_change_vs_60_90_days_ago",
  "description": "Percentage change in active shoppers against the value 60 to 90 days ago",
  "definition": {
   "spec_version": "1.0-draft.4",
   "version": 1,
   "dialect": "snowflake",
   "formula": "100.0 * (SUM(m.ACTIVE_SHOPPERS) - SUM(m.SHOPPERS_90D)) / NULLIF(SUM(m.SHOPPERS_90D), 0)",
   "aggregation": {
    "type": "ratio",
    "reaggregation": "none",
    "null_handling": "ignore"
   },
   "output": {
    "alias": "active_shoppers_change_vs_60_90_days_ago",
    "datatype": "decimal",
    "unit": "percent"
   },
