  <column caption="customer_label" datatype="string" name="[Calculation_f4691c1783f9791a114f]" role="dimension" type="nominal">
    <calculation class="tableau" formula="[C_NAME] + ' - ' + [C_MKTSEGMENT]" />
  </column>
  <column caption="total_revenue" datatype="real" name="[Calculation_60e60fcd98f1121df18c]" role="measure" type="quantitative">
    <calculation class="tableau" formula="SUM([L_EXTENDEDPRICE] * (1 - [L_DISCOUNT]))" />
  </column>
  <column caption="revenue_per_customer" datatype="real" name="[Calculation_6d78da77d529273f365e]" role="measure" type="quantitative">
    <calculation class="tableau" formula="SUM([L_EXTENDEDPRICE] * (1 - [L_DISCOUNT])) / COUNTD([C_CUSTKEY])" />
  </column>
  <column caption="customer_lifetime_revenue" datatype="real" name="[Calculation_1e55446f2bc06d6d5318]" role="measure" type="quantitative">
    <calculation class="tableau" formula="{FIXED [C_CUSTKEY] : SUM([L_EXTENDEDPRICE] * (1 - [L_DISCOUNT]))}" />
  </column>
